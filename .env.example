# Copy to .env and fill in. Required values have no defaults — the server
# refuses to start without them rather than falling back to insecure ones.

# --- required ---
# MongoDB connection string.
MONGO_URL=mongodb://localhost:27017/emr
# Signing key for auth tokens. Use a long random value, unique per
# environment. Never commit a real one.
JWT_SECRET=

# --- optional ---
NODE_ENV=development
PORT=5000
# Comma-separated list of browser origins allowed to call this API with
# credentials. Defaults to http://localhost:3000 when unset.
CORS_ORIGINS=http://localhost:3000

# Outbound email (gmail-send)
SENDEREMAIL=
SENDERPASS=

# Africa's Talking SMS
AT_KEY=

# OpenAI — server-side only, never expose to the browser
OPENAI_API_KEY=
OPENAI_GPT_MODEL=gpt-4o-mini
